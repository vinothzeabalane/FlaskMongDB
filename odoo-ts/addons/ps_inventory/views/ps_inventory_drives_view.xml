<odoo>
    <!-- Define the Form View -->
    <record id="ps_inventory_drives_form_view" model="ir.ui.view">
        <field name="name">ps.inventory.drives.form</field>
        <field name="model">ps.inventory.drives</field>
        <field name="arch" type="xml">
            <form string="PS Inventory">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="density" />
                            <field name="program" />
                            <field name="media_type" />
                        </group>
                        <group>
                            <field name="user_id" string="User" />
                            <field name="product_code_id" />
                            <field name="source" />
                            <field name="host_id" />
                            <field name="ssd_info" />
                        </group>
                    </group>

                    <notebook>
                        <page string="More Information">
                            <group>
                                <group>
                                    <field name="image" widget="image" class="large-image" />
                                </group>
                            </group>
                        </page>

                        <page string="Additional Info">
                            <group>
                                <field name="notes" />
                            </group>
                        </page>
                    </notebook>

                </sheet>
                <form string="History">
                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </form>
        </field>
    </record>

    <!-- Define the Tree View -->
    <record id="ps_inventory_drives_tree_view" model="ir.ui.view">
        <field name="name">ps.inventory.drives.tree</field>
        <field name="model">ps.inventory.drives</field>
        <field name="arch" type="xml">
            <tree string="PS Inventory">
                <field name="name" />
                <field name="density" />
                <field name="product_code_id" />
                <field name="user_id" />
                <field name="program"/>
                <field name="host_id" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- Adding a search view for the custom filter -->
    <record id="ps_inventory_drives_search_view" model="ir.ui.view">
        <field name="name">ps.inventory.drives.search</field>
        <field name="model">ps.inventory.drives</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="density" />
                <field name="program" />
                <field name="user_id" />
                <field name="host_id" />
                <field name="active" />
                <!-- Standard search filters -->
                <filter name="active" string="Active" domain="[('active', '=', True)]" />
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]" />
                <filter name="all" string="All" domain="[]"/>
                <filter name="assigned_user" string="Assigned to Me" domain="[('user_id', '=', uid)]"/>
                <filter name="unassigned_user" string="Unassigned" domain="[('user_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Kanban View for PS Inventory Drives -->
    <record id="ps_inventory_drives_kanban_view" model="ir.ui.view">
        <field name="name">ps.inventory.drives.kanban</field>
        <field name="model">ps.inventory.drives</field>
        <field name="arch" type="xml">
            <kanban string="SSD Drives">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong>
                                    <field name="name" />
                                </strong>
                                <div>
                                    <field name="density" />
                                </div>
                                 <div>
                                    <field name="program" />
                                </div>
                            </div>
                            <footer class="pt-1">
                                <!-- Create a flex container for left and right alignment -->
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <!-- User ID on the left -->
                                    <div class="me-auto">
                                        <field name="user_id" string="User" />
                                    </div>
                                    <!-- User Image on the right with larger size -->
                                    <div class="ms-auto">
                                        <field name="user_id" widget="many2one_avatar_user"
                                            options="{'img_class': 'o_image_large'}" />
                                    </div>
                                </div>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Define the Action for Inventory -->
    <record id="action_ps_inventory_drives" model="ir.actions.act_window">
        <field name="name">PS Inventory</field>
        <field name="res_model">ps.inventory.drives</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="ps_inventory_drives_kanban_view" />
        <field name="domain">[]</field>  <!-- No default domain, shows all records initially -->
        <field name="search_view_id" ref="ps_inventory_drives_search_view"/>
    </record>
    
    <record id="view_ps_inventory_product_code_form" model="ir.ui.view">
        <field name="name">ps.inventory.product.code.form</field>
        <field name="model">ps.inventory.product.code</field>
        <field name="arch" type="xml">
            <form string="Product Code">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>