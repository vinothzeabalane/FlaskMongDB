<odoo>
    <!-- Parent Menu for PS Inventory -->
    <menuitem id="ps_inventory_root_menu"
              name="PS Inventory"
              sequence="10"
              web_icon="ps_inventory,static/description/icon.png"/>

    <!-- Sub Menu for Hosts under PS Inventory -->
    <menuitem id="ps_inventory_hosts_menu"
              name="Hosts"
              action="action_ps_inventory_hosts"
              parent="ps_inventory_root_menu"
              sequence="1" />

    <!-- Sub Menu for SSD Drives under PS Inventory -->
    <menuitem id="ps_inventory_drives_menu"
              name="SSD Drives"
              action="action_ps_inventory_drives"
              parent="ps_inventory_root_menu"
              sequence="2" />
</odoo>
