<odoo>
    <!-- Define the Form View -->
    <record id="ps_inventory_hosts_form_view" model="ir.ui.view">
        <field name="name">ps.inventory.hosts.form</field>
        <field name="model">ps.inventory.hosts</field>
        <field name="arch" type="xml">
            <form string="PS Inventory">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="ip_address" />
                            <field name="location" />
                            <field name="shelf_location"/>
                            <field name="active" />
                        </group>
                        <group>
                            <field name="user_id" string="User" />
                            <field name="drive_info" />
                        </group>
                    </group>

                    <notebook>
                        <page string="PDU Configuration">
                            <group>
                                <group>
                                    <field name="pdu_chewy" widget="url" />
                                    <field name="pdu_chewy_outlet" />
                                </group>
                                <group>
                                    <field name="pdu_dstream" widget="url" />
                                    <field name="pdu_dstream_outlet" />
                                </group>
                            </group>
                        </page>

                        <page string="Hardware Connections">
                            <group>
                                <group>
                                    <field name="has_dap" />
                                    <field name="has_uart" />
                                    <field name="has_pita" />
                                    <field name="has_dstream" />
                                    <field name="has_arm" />
                                    <field name="has_dediprog" />
                                    <field name="has_Flyswatter2" />
                                    <field name="has_cooling_fan" />
                                </group>
                                <group>
                                    <field name="image" widget="image" class="large-image" />
                                </group>
                            </group>
                        </page>

                        <page string="Additional Info">
                            <group>
                                <field name="notes" />
                            </group>
                        </page>
                    </notebook>

                </sheet>
                <form string="History">
                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </form>
        </field>
    </record>

    <!-- Define the Tree View -->
    <record id="ps_inventory_hosts_tree_view" model="ir.ui.view">
        <field name="name">ps.inventory.hosts.tree</field>
        <field name="model">ps.inventory.hosts</field>
        <field name="arch" type="xml">
            <tree string="PS Inventory">
                <field name="name" />
                <field name="ip_address" />
                <field name="user_id" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- Define the Kanban View -->
    <record id="ps_inventory_hosts_kanban_view" model="ir.ui.view">
        <field name="name">ps.inventory.hosts.kanban</field>
        <field name="model">ps.inventory.hosts</field>
        <field name="arch" type="xml">
            <kanban string="PS Inventory">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong>
                                    <field name="name" />
                                </strong>
                                <!-- Display IP Address -->
                                <div>
                                    <field name="ip_address" />
                                </div>
                            </div>
                            <footer class="pt-1">
                                <!-- Create a flex container for left and right alignment -->
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <!-- User ID on the left -->
                                    <div class="me-auto">
                                        <field name="user_id" string="User" />
                                    </div>
                                    <!-- User Image on the right with larger size -->
                                    <div class="ms-auto">
                                        <field name="user_id" widget="many2one_avatar_user"
                                            options="{'img_class': 'o_image_large'}" />
                                    </div>
                                </div>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Adding a search view for the custom filter -->
    <record id="ps_inventory_hosts_search_view" model="ir.ui.view">
        <field name="name">ps.inventory.hosts.search</field>
        <field name="model">ps.inventory.hosts</field>
        <field name="arch" type="xml">
            <search>
                <!-- Standard search filters -->
                <filter name="active" string="Active" domain="[('active', '=', True)]" />
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]" />
                <filter name="all" string="All" domain="[]" />
            </search>
        </field>
    </record>

    <!-- Define the Action for Inventory -->
    <record id="action_ps_inventory_hosts" model="ir.actions.act_window">
        <field name="name">PS Inventory</field>
        <field name="res_model">ps.inventory.hosts</field>
        <field name="view_mode">kanban,tree,form</field>  <!-- Set correct view modes -->
        <field name="view_id" ref="ps_inventory_hosts_kanban_view" />  <!-- Default Kanban view -->
        <field name="domain">[]</field>  <!-- No default domain, shows all records initially -->
        <field name="search_view_id" ref="ps_inventory_hosts_search_view" />
    </record>
</odoo>