<odoo>
    <!-- Hide "Documentation" from the user menu -->
    <record id="user_menu_documentation" model="ir.ui.view">
        <field name="name">user.menu.documentation</field>
        <field name="model">ir.ui.view</field>
        <field name="inherit_id" ref="base.view_user_menu"/>
        <field name="arch" type="xml">
            <xpath expr="//menuitem[@name='Documentation']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide "Support" from the user menu -->
    <record id="user_menu_support" model="ir.ui.view">
        <field name="name">user.menu.support</field>
        <field name="model">ir.ui.view</field>
        <field name="inherit_id" ref="base.view_user_menu"/>
        <field name="arch" type="xml">
            <xpath expr="//menuitem[@name='Support']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide "Shortcuts" from the user menu -->
    <record id="user_menu_shortcuts" model="ir.ui.view">
        <field name="name">user.menu.shortcuts</field>
        <field name="model">ir.ui.view</field>
        <field name="inherit_id" ref="base.view_user_menu"/>
        <field name="arch" type="xml">
            <xpath expr="//menuitem[@name='Shortcuts']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide "Preferences" from the user menu -->
    <record id="user_menu_preferences" model="ir.ui.view">
        <field name="name">user.menu.preferences</field>
        <field name="model">ir.ui.view</field>
        <field name="inherit_id" ref="base.view_user_menu"/>
        <field name="arch" type="xml">
            <xpath expr="//menuitem[@name='Preferences']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide "My Odoo.com account" from the user menu -->
    <record id="user_menu_odoo_com_account" model="ir.ui.view">
        <field name="name">user.menu.odoo_com_account</field>
        <field name="model">ir.ui.view</field>
        <field name="inherit_id" ref="base.view_user_menu"/>
        <field name="arch" type="xml">
            <xpath expr="//menuitem[@name='My Odoo.com account']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Leave the "Logout" option visible -->
    <!-- The logout option is typically already visible, but you can make sure it's available -->
    <record id="user_menu_logout" model="ir.ui.view">
        <field name="name">user.menu.logout</field>
        <field name="model">ir.ui.view</field>
        <field name="inherit_id" ref="base.view_user_menu"/>
        <field name="arch" type="xml">
            <xpath expr="//menuitem[@name='Logout']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>

</odoo>
